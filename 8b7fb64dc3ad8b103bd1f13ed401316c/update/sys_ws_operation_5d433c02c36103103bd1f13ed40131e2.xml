        <http_method>POST</http_method>
        <name>Create Property</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
    var body = request.body.data;
    
    // Validate required fields
    if (!body.name || !body.sys_scope) {
        response.setStatus(400);
        return { error: 'Missing required fields: name, sys_scope' };
    }
    
    var helper = new global.PropertiesHelperGlobal();
    var result = helper.createProperty({
        name: body.name,
        value: body.value || '',
        type: body.type || 'string',
        description: body.description || '',
        sys_scope: body.sys_scope
    });
    
    if (result.error) {
        response.setStatus(400);
        return result;
    }
    
    response.setStatus(201);
    return result;
})(request, response);]]></operation_script>
